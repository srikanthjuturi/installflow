# ─── Database (PostgreSQL) ─────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=videocondb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=require

# ─── JWT ───────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Superadmin bootstrap (python -m app.scripts.bootstrap) ─────────────────
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Super Admin

# Only where something intercepts TLS (corporate proxy / antivirus web shield).
# Leave empty for normal certificate verification.
HTTP_CA_BUNDLE=

# ─── App ───────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
