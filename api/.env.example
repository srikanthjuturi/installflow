# ─── Database (PostgreSQL) ─────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=videocondb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=require

# ─── JWT ───────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Superadmin bootstrap (python -m app.scripts.bootstrap) ─────────────────
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Super Admin

# Only where something intercepts TLS (corporate proxy / antivirus web shield).
# Leave empty for normal certificate verification.
HTTP_CA_BUNDLE=

# ─── WhatsApp Cloud API ────────────────────────────────────────────────────
# Leave empty in development. Invite sends then record a failure the console can
# retry, and OTP codes are written to the server log instead of being sent —
# the whole onboarding flow is walkable without Meta credentials.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ID=
WHATSAPP_API_VERSION=v21.0
# Invite template — UTILITY category, one body parameter (the link).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en_US
# OTP template — must be its own template in the AUTHENTICATION category with a
# copy-code button. Meta reviews it separately and will not deliver a one-time
# code through the UTILITY template above.
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LANG=en_US
# Comma-separated E.164 numbers. When set, ONLY these get a real send.
# Set it to your own number while testing with live credentials — the
# verification scripts request codes for invented numbers, and those
# belong to real people. Leave EMPTY in production.
WHATSAPP_ALLOWLIST=

# ─── Technician onboarding ─────────────────────────────────────────────────
# DEVELOPMENT default: the custom scheme opens the app straight from
#   npx uri-scheme open "videocontech://invite/<token>" --android
# and needs no domain. It CANNOT ship — WhatsApp only auto-links http(s), so a
# videocontech:// link arrives as dead text. Production needs an https
# universal/app link with a web fallback:
#   INVITE_LINK_BASE=https://install.videocon.app/invite
INVITE_LINK_BASE=videocontech://invite
INVITE_EXPIRY_DAYS=14

# ─── OTP ───────────────────────────────────────────────────────────────────
OTP_TTL_SECONDS=600
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=30
OTP_WINDOW_MINUTES=5
OTP_MAX_PER_WINDOW=5
OTP_MAX_PER_IP_PER_WINDOW=20
# REQUIRED in production — startup refuses to boot without it. A 6-digit code
# has 10^6 entropy, so an unpeppered hash is reversible from a database dump.
OTP_PEPPER=
# Returns the code in the response body so the flow can be walked without Meta.
# Startup refuses to boot with this on in production.
OTP_DEV_ECHO=true
REGISTRATION_TOKEN_MINUTES=15

# ─── App ───────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
