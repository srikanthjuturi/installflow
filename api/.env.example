# ─── Database (PostgreSQL) ─────────────────────────────────────────────────
#
# TWO databases, one Azure server. Which one you get is decided by which FILE
# this becomes, and nothing else — there is no environment switch in the code:
#
#   .env             development   POSTGRES_DB=RelianceDB
#   .env.production  production    POSTGRES_DB=RelianceProdDB
#
# publish.py copies `.env.production` into the deployment zip as `.env`, and
# refuses to deploy unless POSTGRES_DB names the production database.
#
# The names are MIXED CASE. A connection string passes the name through
# verbatim so `POSTGRES_DB=RelianceProdDB` is correct as written, but raw SQL
# must quote it — an unquoted identifier folds to lower case and does not
# resolve. `python -m app.scripts.create_database` handles that for you.
#
# To point a one-off command at the other database, set the environment
# variable: it outranks whatever this file says.
#
#   $env:POSTGRES_DB='RelianceProdDB'; python -m alembic upgrade head
#
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=RelianceDB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=require

# ─── JWT ───────────────────────────────────────────────────────────────────
# Never share this between environments. The two databases hold their own
# refresh tokens, so one key across both would let a dev token authenticate
# against production. Generate per environment:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Superadmin bootstrap (python -m app.scripts.bootstrap) ─────────────────
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Super Admin

# Only where something intercepts TLS (corporate proxy / antivirus web shield).
# Leave empty for normal certificate verification.
HTTP_CA_BUNDLE=

# ─── WhatsApp Cloud API ────────────────────────────────────────────────────
# Leave empty in development. Invite sends then record a failure the console can
# retry, and OTP codes are written to the server log instead of being sent —
# the whole onboarding flow is walkable without Meta credentials.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ID=
WHATSAPP_API_VERSION=v21.0
# Invite template — UTILITY category, one body parameter (the link).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en_US
# OTP template — must be its own template in the AUTHENTICATION category with a
# copy-code button. Meta reviews it separately and will not deliver a one-time
# code through the UTILITY template above.
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LANG=en_US
# The two ticket messages, both UTILITY, both three body parameters. Leave them
# empty and the code still sends — as PLAIN TEXT, which Meta accepts, returns a
# message id for, and then silently drops unless the customer messaged this
# number in the last 24 hours. That is why a confirmation can read "sent" in the
# timeline and never arrive; a template is what makes it turn up.
#   slot_confirmed  {{1}} company · {{2}} product · {{3}} when
#   slot_request    {{1}} company · {{2}} product · {{3}} link
WHATSAPP_SLOT_CONFIRMED_TEMPLATE_NAME=
WHATSAPP_SLOT_TEMPLATE_NAME=
# One language for BOTH slot templates — create them in the same one.
WHATSAPP_SLOT_TEMPLATE_LANG=en_US
# The customer's "confirm the job is done" message. UTILITY, four body
# parameters, and the same silent-drop trap as the two above if left empty:
#   job_feedback  {{1}} company · {{2}} product · {{3}} technician · {{4}} link
# Meta rejects a body that STARTS or ends with a variable (subcode 2388299),
# which is why the registered text opens "Your {{2}} installation from {{1}}".
WHATSAPP_FEEDBACK_TEMPLATE_NAME=
WHATSAPP_FEEDBACK_TEMPLATE_LANG=en_US
# Who accepted the job, the moment they accept it. EMPTY until the UTILITY
# templates below are APPROVED in WhatsApp Manager — both were submitted on
# 2026-09-05 and are PENDING. Fill in the names on the right of the `=` when
# Meta approves; nothing else changes.
#
#   WHATSAPP_ACCEPTED_TEMPLATE_NAME=job_accepted                 (5 params)
#   WHATSAPP_ACCEPTED_MANAGER_TEMPLATE_NAME=job_accepted_manager (4 params)
#
# ⚠ Empty does NOT mean "plain text arrives instead". The fallback is free-form
# text, which Meta only delivers inside the 24-hour customer-service window —
# to somebody who has messaged this number recently. A customer has not, so the
# send is accepted, given a message id, and DROPPED with 131047, invisibly.
# Until approval these two messages reach nobody. The vendor's bell and the
# manager's console notification are in-app and work regardless.
#
# ⚠ Do not set these in .env.production before they are APPROVED —
# `publish.py` refuses to deploy on a template Meta does not recognise or is
# still reviewing, which is the guard working, not a bug.
WHATSAPP_ACCEPTED_TEMPLATE_NAME=
WHATSAPP_ACCEPTED_TEMPLATE_LANG=en_US
WHATSAPP_ACCEPTED_MANAGER_TEMPLATE_NAME=
WHATSAPP_ACCEPTED_MANAGER_TEMPLATE_LANG=en_US
# The one message this system sends to its own STAFF. Managers have no mobile
# app, so an escalation four hours from a slot cannot wait for somebody to open
# a browser tab. Area managers only — every rank above covers enough ground that
# a message per escalation becomes a message they mute.
WHATSAPP_ESCALATION_TEMPLATE_NAME=job_escalation
WHATSAPP_ESCALATION_TEMPLATE_LANG=en_US
# Comma-separated E.164 numbers. When set, ONLY these get a real send.
# Set it to your own number while testing with live credentials — the
# verification scripts request codes for invented numbers, and those
# belong to real people. Leave EMPTY in production.
WHATSAPP_ALLOWLIST=

# ─── Technician onboarding ─────────────────────────────────────────────────
# DEVELOPMENT default: the custom scheme opens the app straight from
#   npx uri-scheme open "reliancegreentech://invite/<token>" --android
# and needs no domain. It CANNOT ship — WhatsApp only auto-links http(s), so a
# reliancegreentech:// link arrives as dead text. Production needs an https
# universal/app link with a web fallback:
#   INVITE_LINK_BASE=https://install.reliancegreentech.in/invite
INVITE_LINK_BASE=reliancegreentech://invite
INVITE_EXPIRY_DAYS=14
# The APK the invite landing page offers under "I don't have the app yet".
# Goes stale on every mobile build: left pointing at an older one, technicians
# install an app aimed at a dead API and every invite looks expired.
TECHNICIAN_APP_LINK=
# The deep-link scheme the landing page hands to the app.
APP_SCHEME=reliancegreentech

# ─── Customer links ────────────────────────────────────────────────────────
# Where the customer picks a slot, and where they confirm the job was done.
# BOTH must be a public https origin in production — they go out in a WhatsApp
# message BODY, and WhatsApp only makes a real hostname tappable, so the
# localhost defaults arrive as dead text. Never a tunnel either: a quick-tunnel
# hostname dies with the process that made it, and every link already sent goes
# with it. publish.py refuses to deploy unless both name the deployed site.
SLOT_LINK_BASE=http://localhost:8000/slot
FEEDBACK_LINK_BASE=http://localhost:8000/feedback

# ─── Blob storage ──────────────────────────────────────────────────────────
# Leave the connection string empty in development: uploads then fail with a
# message rather than crashing, and every screen that shows an image renders
# its empty state.
AZURE_STORAGE_CONNECTION_STRING=
# Public read — avatars, product photos, category icons.
AZURE_BLOB_CONTAINER=installflow-media
# PRIVATE, no public access. Proof photographs are the inside of a customer's
# home and a serial off their appliance; reads go through a short-lived SAS
# URL minted per request, and the row stores the blob NAME, never a URL.
# It must EXIST before the first proof upload — nothing creates it.
AZURE_PROOF_CONTAINER=installflow-proof

# ─── Azure Communication Services (email) ──────────────────────────────────
# The only outbound EMAIL channel. WhatsApp carries everything aimed at a
# phone; this carries the one thing aimed at an inbox — the temporary password
# a new console account is created with.
#
# Empty disables sending the same way an empty WHATSAPP_TOKEN does: nothing
# 500s, the account is still created, and the password comes back in the
# response for the manager to hand over. From the Communication Services
# resource → Keys. NEVER commit the real value.
ACS_CONNECTION_STRING=
# A verified MailFrom of that resource's email domain. ACS rejects any other
# sender with a 400, so a typo means every email fails while nothing else
# changes. No default on purpose: an invented address sends nothing while
# looking configured.
ACS_SENDER_ADDRESS=
ACS_SENDER_NAME=Reliance GreenTech
# Where the "Sign in" button in an email points. This is the CONSOLE's origin
# (Netlify in production), NOT this API's — a localhost value sends perfectly
# and arrives as a dead button, which is why startup refuses it in production.
CONSOLE_LINK_BASE=http://localhost:5173
# Hard ceiling on one send. Creating a user blocks on it.
ACS_TIMEOUT_SECONDS=20
# ⚠ Comma-separated addresses. When set, ONLY these receive a real send.
#
# Set it to your own address while testing. Development and production share
# ONE ACS resource, so live credentials plus somebody exercising the create
# form sends real mail to invented addresses that belong to real people.
# Empty = anyone, i.e. production — and `publish.py` refuses a deploy with it
# set, because in production it silently drops mail to everyone not named.
ACS_EMAIL_ALLOWLIST=

# ─── Google Sign-In (console) ──────────────────────────────────────────────
# Blank here on purpose: the real value is a DEFAULT in app/core/config.py, the
# same arrangement CORS_ORIGINS and ANDROID_PACKAGE have, because a client id is
# public (it is inlined into the console bundle) and so belongs with the code
# rather than in a file somebody has to remember to update twice.
#
# Set this only to aim one machine at a different Google project. There is no
# client SECRET anywhere: the browser receives a signed ID token directly, with
# no authorization code and no token exchange for a secret to sign.
GOOGLE_CLIENT_ID=

# ─── OTP ───────────────────────────────────────────────────────────────────
OTP_TTL_SECONDS=600
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=30
OTP_WINDOW_MINUTES=5
OTP_MAX_PER_WINDOW=5
OTP_MAX_PER_IP_PER_WINDOW=20
# REQUIRED in production — startup refuses to boot without it. A 6-digit code
# has 10^6 entropy, so an unpeppered hash is reversible from a database dump.
OTP_PEPPER=
# Returns the code in the response body so the flow can be walked without Meta
# credentials — and, for a password reset, without a working mailbox. Startup
# refuses to boot with this on in production.
OTP_DEV_ECHO=true
REGISTRATION_TOKEN_MINUTES=15
# The ticket between a verified password-reset code and the new password.
PASSWORD_RESET_TOKEN_MINUTES=15

# ─── App ───────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ─── Android App Links ─────────────────────────────────────────────────────
# SHA-256 of the app signing certificate: apksigner verify --print-certs app.apk
# Comma-separated; a Play-signed build has a different one and needs both.
ANDROID_PACKAGE=com.reliancegreentech.technician
ANDROID_CERT_FINGERPRINTS=

# ─── Push notifications ────────────────────────────────────────────────────
# Technician app only — the console has a live socket and a bell, and nowhere
# to push to. Sends go through Expo's push service, which holds the FCM
# credential (uploaded once to EAS), so NO Firebase secret belongs in this file.
#
# Leave PUSH_ENABLED false until the FCM V1 service account is actually on EAS:
# with it on and the credential missing, every notification spends a round trip
# to Expo discovering it cannot be delivered.
PUSH_ENABLED=false
# Optional, from expo.dev > Account settings > Access tokens. With it set, Expo
# refuses any send that does not carry it — so a push token lifted off a device
# cannot be used to send notifications to this app's users.
EXPO_ACCESS_TOKEN=

# ─── Web push (the ops console and the vendor portal) ──────────────────────
# The browser half of the above. A manager with the console in another tab, or
# shut altogether, gets an operating-system notification instead of a toast.
#
# Generate the pair ONCE per environment (py-vapid ships with pywebpush):
#     vapid --gen                      # writes private_key.pem / public_key.pem
#     vapid --applicationServerKey     # the base64url public key for below
# Rotating them invalidates every subscription already granted, so everybody
# has to switch desktop alerts on again. Generate once and leave them alone.
#
# The PUBLIC key is served to browsers by GET /notifications/web-push-key and
# is not a secret. The PRIVATE key is what proves a push came from this server;
# it belongs in this gitignored file and nowhere else.
WEB_PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Required by the standard — a real address a push service can complain to.
VAPID_SUBJECT=mailto:support@reliancegreentech.in

# ─── Scheduled sweeps ──────────────────────────────────────────────────────
# How often the four time-based sweeps run. Both Azure workers wake together and
# a Postgres advisory lock picks one.
#
# The only sweep setting left here. The windows themselves — the escalation
# trigger, the re-notify grace, slot silence, the force-close wait and the slot
# reminder — are PER COMPANY now, in the `company_rules` table, edited on
# Configuration → Rules Config. They were environment variables while this
# product was multi-tenant, which meant one escalation window for every company
# on the server. Setting them here does nothing; delete them from any .env that
# still carries them.
#
# This one stays because it is infrastructure rather than policy, and because it
# is the resolution limit all of those are subject to: nothing fires more
# precisely than one tick.
SWEEP_INTERVAL_SECONDS=300
