# ─── Database (PostgreSQL) ─────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=videocondb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=require

# ─── JWT ───────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Superadmin bootstrap (python -m app.scripts.bootstrap) ─────────────────
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Super Admin

# ─── WhatsApp Cloud API (partner invites) ──────────────────────────────────
# Use a System User token, not a dashboard "temporary" one — the latter dies
# after 24h. Required scope: whatsapp_business_messaging.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ID=
WHATSAPP_API_VERSION=v21.0
# Leave the template name empty to send plain text — which WhatsApp only
# delivers to someone who messaged the business in the last 24h. Set an
# APPROVED template name for real, business-initiated invites.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en_US

# ─── Partner invites ───────────────────────────────────────────────────────
PARTNER_APP_LINK=https://install.videocon.app/technician
INVITE_LINK_BASE=https://install.videocon.app/invite

# Only where something intercepts TLS (corporate proxy / antivirus web shield).
# Leave empty for normal certificate verification.
HTTP_CA_BUNDLE=

# ─── App ───────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
