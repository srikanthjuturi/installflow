# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environment
.venv/
venv/

# Environment / secrets — every variant except the checked-in template.
# A pattern, not literal names: `.env` alone did not cover a dated backup
# like `.env.bak.20260824`, which holds a live password and would have been
# committed by `git add .`.
.env
.env.*
!.env.example

# OS / editor
.DS_Store
.idea/
.vscode/

# Azure publish profile — contains a deployment password
*.PublishSettings
