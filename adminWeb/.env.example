# Copy to `.env`. Both `.env` and `.env.local` are git-ignored; this file is the
# only one in the repository, so it is where the arrangement is written down.
#
# ─── Which database you are looking at ─────────────────────────────────────
#
# The console has no database of its own — VITE_API_BASE_URL decides everything,
# because the two API deployments read different databases:
#
#   .env.local   ->  http://127.0.0.1:8000/api/v1   your local API   -> RelianceDB     (development)
#   deployed dev ->  installflowapi-dev, via WEB_ENV_FILE_DEV      -> RelianceDB     (development)
#   deployed prod -> installflowapi,    via WEB_ENV_FILE_PROD      -> RelianceProdDB (production)
#
# **Production must use the production database only**, and it does: both
# deployed builds take VITE_API_BASE_URL from a GitHub secret written to
# `.env.production` before the remote build (`web-dev-deploy.yml` writes
# `WEB_ENV_FILE_DEV`, `web-prod-deploy.yml` writes `WEB_ENV_FILE_PROD` — the
# dev build points at installflowapi-dev) — and `api/scripts/publish.py`
# refuses to deploy the production API unless its POSTGRES_DB is the
# production database.
#
# Vite ranks `.env.local` ABOVE `.env`, so while `.env.local` exists every local
# `npm run dev` AND `npm run build` targets your local API, whatever `.env` says.
# That is the safe default. Delete or rename `.env.local` to aim a local session
# at production, and put it back afterwards.
#
# Setting VITE_API_BASE_URL is mandatory for a deployed build: unset, the bundle
# falls back to `http://localhost:8000/api/v1` and every screen fails at once
# against an address the visitor's browser resolves to their own machine.
#
# See api/AGENTS.md -> Environments.
VITE_API_BASE_URL=https://installflowapi-dev-c2fqf7f4bjdbg8bz.centralindia-01.azurewebsites.net/api/v1

# ─── Google Sign-In ────────────────────────────────────────────────────────
# The OAuth **web client id** behind "Continue with Google" and One Tap on the
# sign-in page. A VITE_* value is inlined into the bundle, so a client id is
# public by design — that is what a client id is. There is no client SECRET
# here or on the API: the browser receives a signed ID token directly, with no
# authorization code and therefore no exchange for a secret to sign.
#
# It must match GOOGLE_CLIENT_ID on the API, which keeps it as a default in
# `api/app/core/config.py`. A mismatch fails every sign-in with a bare 401.
#
# ⚠ Mandatory in the deployed build too (the WEB_ENV_FILE_DEV / WEB_ENV_FILE_PROD
# secrets). Those builds start with no .env files, so without it the deployed
# console silently renders no Google button while your local one works. Unset is
# a valid state — the page falls back to email and password with no button and no
# error.
#
# ⚠ The console's origin must also be listed under "Authorized JavaScript
# origins" on that client in Google Cloud, including BOTH localhost and
# 127.0.0.1 on ports 5173-5175. A missing origin fails entirely client-side:
# the button does nothing and no request ever reaches the API.
VITE_GOOGLE_CLIENT_ID=

# ─── Google Maps ───────────────────────────────────────────────────────────
# Maps JavaScript API + Places API, for the address autocomplete in AddressFields.
# A VITE_* value is inlined into the bundle, so this key is public by design and
# is only safe while it stays HTTP-referrer restricted to the console's origins
# in Google Cloud. Mandatory in a deployed build too — see adminWeb/AGENTS.md.
VITE_GOOGLE_MAPS_API_KEY=

# ─── Analytics & diagnostics ───────────────────────────────────────────────
# Three tools, three jobs: GA4 is business/conversion KPIs, Clarity is
# session-replay/heatmap UX diagnosis, PostHog is error capture plus the same
# conversion events with full funnel detail. Each is independently optional —
# an unset id/key simply leaves that integration off, exactly like the two
# Google keys above; nothing in `lib/analytics/` throws on a missing value.
#
# All four are `VITE_*`, so all four are inlined into the bundle and are
# public by design — none of these ids/keys are secrets.
#
# ⚠ PRODUCTION ONLY. Leave all four EMPTY here and in `.env.local`, and in the
# WEB_ENV_FILE_DEV secret for the dev App Service. Set them only in the
# `WEB_ENV_FILE_PROD` secret for the production deploy. `npm run dev` would not
# track even with values here — `lib/analytics/config.ts` requires a production
# build — but a local `npm run build` would.

# GA4 measurement id, e.g. "G-XXXXXXXXXX", from the GA4 property's Data Streams.
VITE_GA_MEASUREMENT_ID=

# Microsoft Clarity project id, from the project's Settings > Overview.
VITE_CLARITY_PROJECT_ID=

# PostHog project API key ("phc_..."), from Project Settings.
VITE_POSTHOG_KEY=

# PostHog ingestion host. Only matters for a project on a non-US region —
# leave unset to use PostHog's US default (https://us.i.posthog.com).
VITE_POSTHOG_HOST=
