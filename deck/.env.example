# Copy to `deck/.env`, which is git-ignored. These are read for `POST /auth/login`
# and nothing else — they are never written back to disk and never logged.

# ─── Production console + vendor portal ──────────────────────────────────────
# Used against the LIVE site, which reads RelianceProdDB. Reads only: the
# interceptor in capture/lib/guard.mjs aborts every write except signing in.
DECK_ADMIN_EMAIL=
DECK_ADMIN_PASSWORD=

DECK_AREA_MANAGER_EMAIL=
DECK_AREA_MANAGER_PASSWORD=

DECK_VENDOR_EMAIL=
DECK_VENDOR_PASSWORD=

# ─── Development, for the two customer-facing pages ──────────────────────────
# A vendor on the DEVELOPMENT database. The customer slot page needs a live
# single-use token, and minting one in production would WhatsApp a real customer.
DECK_DEV_VENDOR_EMAIL=
DECK_DEV_VENDOR_PASSWORD=

# ─── Addresses (defaults are usually right) ──────────────────────────────────
# DECK_CONSOLE_URL=https://reliancegreentech.netlify.app
# DECK_APP_URL=http://localhost:8081
# DECK_LOCAL_API=http://127.0.0.1:8000/api/v1
# DECK_DEV_API=http://127.0.0.1:8000/api/v1
