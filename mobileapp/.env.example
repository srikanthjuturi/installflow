# Analytics is PRODUCTION ONLY. Its keys live in the `production` profile of
# `eas.json` and nowhere else — do not copy them into a local `.env`. Expo Go and
# dev-client builds never track even if you do (`src/lib/analytics/config.ts`
# requires `!__DEV__`), but a local release build would.
#
# Listed here only so every variable the app reads is written down once.

# GA4 Measurement Protocol — coarse business/conversion KPIs only.
EXPO_PUBLIC_GA_MEASUREMENT_ID=
EXPO_PUBLIC_GA_API_SECRET=

# PostHog — error capture and the same conversion events with full detail.
EXPO_PUBLIC_POSTHOG_KEY=
# Defaults to https://us.i.posthog.com; our project is on EU Cloud.
EXPO_PUBLIC_POSTHOG_HOST=

# Microsoft Clarity — session replay and rage taps. Native module: never in Expo Go.
EXPO_PUBLIC_CLARITY_PROJECT_ID=
